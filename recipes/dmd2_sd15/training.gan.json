{
  "schema_version": "distillschedule.training.v1",
  "model": {
    "name": "sd15",
    "parameters": {
      "source_root": "/ABSOLUTE/LOCAL/EXTERNAL_DMD2_SOURCE",
      "model_id": "/ABSOLUTE/LOCAL/SD15_BUNDLE",
      "settings": {
        "dfake_gen_update_ratio": 10,
        "generator_lr": 1e-06,
        "guidance_lr": 1e-06,
        "resolution": 512,
        "latent_resolution": 64,
        "conditioning_timestep": 999,
        "warmup_step": 500,
        "train_iters": 1000000,
        "cls_on_clean_image": true,
        "gen_cls_loss": true,
        "gen_cls_loss_weight": 0.01,
        "guidance_cls_loss_weight": 0.01,
        "dm_loss_weight": 1.0,
        "gan_alone": false,
        "diffusion_gan": false,
        "diffusion_gan_max_timestep": 0
      }
    }
  },
  "algorithm": {
    "name": "dmd2"
  },
  "data": {
    "streams": {
      "generator": {
        "prepared": "/ABSOLUTE/LOCAL/PROMPTS/prepared/manifest.json",
        "samples_per_cycle": 1,
        "sampling": {
          "kind": "epochs",
          "shuffle": true
        }
      },
      "guidance": {
        "prepared": "/ABSOLUTE/LOCAL/PROMPTS/prepared/manifest.json",
        "samples_per_cycle": 9,
        "sampling": {
          "kind": "epochs",
          "shuffle": true
        }
      },
      "real": {
        "prepared": "/ABSOLUTE/LOCAL/REAL_RGB_OR_PINNED_LATENTS/prepared/manifest.json",
        "samples_per_cycle": 10,
        "sampling": {
          "kind": "epochs",
          "shuffle": true
        }
      }
    }
  },
  "execution": {
    "adapter": "program",
    "mode": "reference"
  },
  "trainer": {
    "cycles": 2,
    "seed": 17,
    "device": "cpu",
    "output_dir": "/ABSOLUTE/PROJECT/DMD2_SD15_GAN_RUN",
    "checkpoint_every": 1
  }
}
