{
  "schema_version": "distillschedule.training.v1",
  "model": {
    "factory": "distillschedule.training.helios_public:build_model",
    "parameters": {
      "asset_manifest": "/absolute/local/helios-reference/assets.json"
    }
  },
  "data": {
    "prepared": "/absolute/local/helios-reference/prepared/manifest.json",
    "sampling": {"kind": "finite", "shuffle": false}
  },
  "algorithm": {"factory": "distillschedule.training.helios_public:build_algorithm"},
  "execution": {"adapter": "program", "mode": "reference"},
  "trainer": {
    "cycles": 2,
    "device": "cpu",
    "seed": 773,
    "checkpoint_every": 1,
    "output_dir": "/absolute/local/helios-reference/run"
  }
}
