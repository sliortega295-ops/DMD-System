# Source this file on either BAAI Helios node before invoking distillctl.
# It contains paths only; no credentials or mutable experiment identifiers.
export DMD_SYSTEM_ROOT=/share/project/shuchenweng/yongyan_liu/DMD-System
export HELIOS_RUNTIME_ROOT=/share/project/shuchenweng/yongyan_liu/DistillSchedule
export DISTILLSCHEDULE_PYTHON=/tmp/distillschedule-helios-official-torch210/bin/python
export DISTILLSCHEDULE_ACCELERATE=/tmp/distillschedule-helios-official-torch210/bin/accelerate

export HELIOS_DISTILLED_ROOT=/share/project/shuchenweng/DistillSchedule_assets/Helios-Distilled
export HELIOS_BASE_ROOT=/home/shuchenweng/xty/Helios-main/weights
export HELIOS_DATA_ROOT=/share/project/shuchenweng/DistillSchedule_assets/m0/datasets/syn_feature_single
export DISTILLSCHEDULE_TRACE_BUNDLE=/share/project/shuchenweng/DistillSchedule_assets/m0/traces/syn_feature_trace_v2_steps20
export DISTILLSCHEDULE_CHECKPOINT=/share/project/shuchenweng/yongyan_liu/DistillSchedule/artifacts/runs/iteration65_m0_b4fast_canonical_checkpoint10_001/checkpoint-10

# Keep typed-runtime imports in the controller.  The rendered Helios child
# receives HELIOS_RUNTIME_ROOT as PYTHONPATH from the plan and therefore uses
# the validated compatibility checkout rather than shadowing it with this repo.
export PYTHONPATH="${DMD_SYSTEM_ROOT}/src:${DMD_SYSTEM_ROOT}"

