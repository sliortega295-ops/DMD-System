# BAAI site profile for the official-semantics GAN-on Route-A baseline.
# Copy this to a private untracked path on both nodes and fill the three GAN
# experiment assets plus the pinned Helios source identity. No credentials belong here.

export DMD_SYSTEM_ROOT=${DMD_SYSTEM_ROOT:-/share/project/shuchenweng/yongyan_liu/DMD-System}
export HELIOS_RUNTIME_ROOT=${HELIOS_RUNTIME_ROOT:-/share/project/shuchenweng/yongyan_liu/DistillSchedule}
export DISTILLSCHEDULE_PYENV=${DISTILLSCHEDULE_PYENV:-/tmp/distillschedule-helios-official-torch210}
export DISTILLSCHEDULE_PYTHON=${DISTILLSCHEDULE_PYTHON:-${DISTILLSCHEDULE_PYENV}/bin/python}
export DISTILLSCHEDULE_ACCELERATE=${DISTILLSCHEDULE_ACCELERATE:-${DISTILLSCHEDULE_PYENV}/bin/accelerate}
export DISTILLSCHEDULE_DEEPSPEED=${DISTILLSCHEDULE_DEEPSPEED:-${DISTILLSCHEDULE_PYENV}/bin/deepspeed}

export HELIOS_DISTILLED_ROOT=${HELIOS_DISTILLED_ROOT:-/share/project/shuchenweng/DistillSchedule_assets/Helios-Distilled}
export HELIOS_BASE_ROOT=${HELIOS_BASE_ROOT:-/home/shuchenweng/xty/Helios-main/weights}
export DISTILLSCHEDULE_PRECAST_GENERATOR_PATH=${DISTILLSCHEDULE_PRECAST_GENERATOR_PATH:-/share/project/shuchenweng/DistillSchedule_assets/precast/helios-distilled-transformer-ode-mixed-bf16-v1}
export DISTILLSCHEDULE_PRECAST_SCORE_PATH=${DISTILLSCHEDULE_PRECAST_SCORE_PATH:-/share/project/shuchenweng/DistillSchedule_assets/precast/helios-score-transformer-mixed-bf16-v1}
export DISTILLSCHEDULE_DEEPSPEED_CONFIG=${DISTILLSCHEDULE_DEEPSPEED_CONFIG:-${DMD_SYSTEM_ROOT}/scripts/accelerate_configs/zero1_cpu_optimizer_offload.json}

# GAN-specific immutable experiment assets. These are intentionally not guessed.
# They must come from one source-faithful GAN-on continuation contract.
export HELIOS_GAN_DATA_ROOT=${HELIOS_GAN_DATA_ROOT:-}
export DISTILLSCHEDULE_GAN_TRACE_BUNDLE=${DISTILLSCHEDULE_GAN_TRACE_BUNDLE:-}
export DISTILLSCHEDULE_GAN_CHECKPOINT=${DISTILLSCHEDULE_GAN_CHECKPOINT:-}

# Pin the validated external Helios checkout. The baseline launcher rejects a
# dirty checkout or a mismatch. Do not point this at an arbitrary newer HEAD.
export DISTILLSCHEDULE_EXPECTED_HELIOS_HEAD=${DISTILLSCHEDULE_EXPECTED_HELIOS_HEAD:-}
export DISTILLSCHEDULE_EXPECTED_HELIOS_ENTRYPOINT_SHA256=${DISTILLSCHEDULE_EXPECTED_HELIOS_ENTRYPOINT_SHA256:-}

export PYTHONPATH=${DMD_SYSTEM_ROOT}/src:${DMD_SYSTEM_ROOT}
